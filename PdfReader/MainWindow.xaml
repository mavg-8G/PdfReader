<Window
    x:Class="PdfReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PdfReader.Views"
    xmlns:controls="using:PdfReader.Controls"
    Title="Folio">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Background="Transparent"
        Loaded="Root_Loaded"
        SizeChanged="Root_SizeChanged"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Grid.Resources>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="9"/>
            </Style>
            <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Folio"
            Subtitle="PDF reader"
            BackRequested="TitleBar_BackRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Square44x44Logo.scale-200.png"/>
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,4,0">
                    <Button x:Name="HelpButton" Click="Help_Click" Style="{StaticResource TitleBarButton}"><FontIcon Glyph="&#xE897;" FontSize="16"/></Button>
                    <Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource TitleBarButton}"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1" x:Name="Workspace">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border
                x:Name="ToolbarArea"
                Visibility="Collapsed"
                Padding="4,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <CommandBar
                    x:Name="Toolbar"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="True"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent">
                    <CommandBar.Content>
                        <UserControl x:Name="NavigationControls" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                <Button x:Name="SidebarButton" Click="Sidebar_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE8F1;" FontSize="16"/></Button>
                                <Border Width="1" Height="20" Margin="3,0,5,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Button x:Name="PreviousButton" Click="Previous_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
                                <TextBox x:Name="PageBox" Width="46" MinWidth="46" MinHeight="32" Text="1" TextAlignment="Center" VerticalAlignment="Center" KeyDown="PageBox_KeyDown" LostFocus="PageBox_LostFocus"/>
                                <TextBlock x:Name="PageCountText" Text="/ 0" MinWidth="32" Margin="4,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <Button x:Name="NextButton" Click="Next_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
                                <Border Width="1" Height="20" Margin="6,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Button x:Name="ZoomOutButton" Click="ZoomOut_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE738;" FontSize="14"/></Button>
                                <Button x:Name="ZoomButton" Content="100%" MinWidth="64" Style="{StaticResource QuietButton}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem x:Name="ScaleWidthItem" Text="Fit to width" Tag="page-width" KeyboardAcceleratorTextOverride="Ctrl+2" Click="Scale_Click"/>
                                            <MenuFlyoutItem x:Name="ScalePageItem" Text="Fit to page" Tag="page-fit" KeyboardAcceleratorTextOverride="Ctrl+0" Click="Scale_Click"/>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="50%" Tag="0.5" Click="Scale_Click"/>
                                            <MenuFlyoutItem Text="75%" Tag="0.75" Click="Scale_Click"/>
                                            <MenuFlyoutItem x:Name="ActualSizeItem" Text="100% · Actual size" Tag="1" KeyboardAcceleratorTextOverride="Ctrl+1" Click="Scale_Click"/>
                                            <MenuFlyoutItem Text="150%" Tag="1.5" Click="Scale_Click"/>
                                            <MenuFlyoutItem Text="200%" Tag="2" Click="Scale_Click"/>
                                            <MenuFlyoutItem Text="400%" Tag="4" Click="Scale_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ZoomInButton" Click="ZoomIn_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button>
                            </StackPanel>
                        </UserControl>
                    </CommandBar.Content>
                    <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open PDF" Click="Open_Click"/>
                    <AppBarSeparator/>
                    <AppBarButton x:Name="FindButton" Icon="Find" Label="Search" Click="Find_Click" IsEnabled="False"/>
                    <AppBarButton x:Name="AnnotateButton" Icon="Edit" Label="Annotate" Click="Annotate_Click" IsEnabled="False"/>
                    <AppBarButton x:Name="OcrButton" Icon="Scan" Label="Read scanned page" Click="Ocr_Click" IsEnabled="False"/>
                    <AppBarButton x:Name="RotateButton" Icon="Rotate" Label="Rotate clockwise" Click="Rotate_Click" IsEnabled="False"/>
                    <AppBarSeparator/>
                    <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save a copy" Click="Save_Click" IsEnabled="False"/>
                    <AppBarButton x:Name="PrintButton" Icon="Print" Label="Print" Click="Print_Click" IsEnabled="False"/>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Name="FitWidthMenu" Label="Fit to width" KeyboardAcceleratorTextOverride="Ctrl+2" Click="FitWidth_Click"/>
                        <AppBarButton x:Name="FitPageMenu" Label="Fit to page" KeyboardAcceleratorTextOverride="Ctrl+0" Click="FitPage_Click"/>
                        <AppBarButton x:Name="FullscreenMenu" Label="Fullscreen" KeyboardAcceleratorTextOverride="F11" Click="Fullscreen_Click"/>
                        <AppBarButton x:Name="PresentationMenu" Label="Presentation" KeyboardAcceleratorTextOverride="F5" Click="Presentation_Click"/>
                        <AppBarSeparator/>
                        <AppBarButton x:Name="CloseMenu" Label="Close document" KeyboardAcceleratorTextOverride="Ctrl+W" Click="Close_Click"/>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Border>

            <StackPanel Grid.Row="1" x:Name="Notices">
                <InfoBar x:Name="MessageBar" Margin="12,8,12,8" IsOpen="False" IsClosable="True" Severity="Error"/>
                <ProgressBar x:Name="LoadingBar" Visibility="Collapsed" IsIndeterminate="True" Height="3"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <SplitView x:Name="DocumentSplit" Visibility="Collapsed" OpenPaneLength="216" DisplayMode="Inline" IsPaneOpen="False" PaneBackground="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <SplitView.Pane>
                        <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="PagesHeading" Text="Pages" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="20,0" VerticalAlignment="Center"/>
                            <ListView x:Name="Thumbnails" Grid.Row="1" SelectionMode="Single" SelectionChanged="Thumbnails_SelectionChanged" ContainerContentChanging="Thumbnails_ContainerContentChanging" Padding="12,0,12,12" HorizontalContentAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="10" Spacing="8" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Label}">
                                            <Border Width="128" Height="166" Background="White" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <Image Source="{Binding Image}" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/>
                                            </Border>
                                            <TextBlock Text="{Binding Page}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </SplitView.Pane>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <controls:PdfViewer x:Name="DocumentView"/>
                        <Border
                            x:Name="SidePanel"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Width="340"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                            <Grid>
                                <ScrollViewer x:Name="OcrPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Padding="20,12,20,20" Spacing="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="OcrHeading" Text="Read scanned page" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <Button x:Name="OcrCloseButton" Grid.Column="1" Click="ClosePanel_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                                        </Grid>
                                        <TextBlock x:Name="OcrDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="OcrLanguageBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                            <ComboBoxItem x:Name="OcrEnglishItem" Content="English" Tag="en"/>
                                            <ComboBoxItem x:Name="OcrSpanishItem" Content="Español" Tag="es"/>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="OcrReadButton" Style="{StaticResource AccentButtonStyle}" Click="OcrRead_Click"/>
                                            <Button x:Name="OcrCancelButton" Visibility="Collapsed" Click="OcrCancel_Click"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="OcrProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                                        <TextBlock x:Name="OcrStatus" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                                        <TextBox x:Name="OcrText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" IsSpellCheckEnabled="False" MinHeight="180" MaxHeight="380" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        <Button x:Name="OcrCopyButton" IsEnabled="False" Click="OcrCopy_Click"/>
                                        <TextBlock x:Name="OcrNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <ScrollViewer x:Name="AnnotationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Padding="20,12,20,20" Spacing="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AnnotationHeading" Text="Annotations" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <Button x:Name="AnnotationCloseButton" Grid.Column="1" Click="ClosePanel_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                                        </Grid>
                                        <TextBlock x:Name="AnnotationDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ToggleButton x:Name="NoteToolButton" Click="NoteTool_Click"/>
                                            <ToggleButton x:Name="DrawToolButton" Click="DrawTool_Click"/>
                                        </StackPanel>
                                        <TextBox x:Name="NoteTextBox" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="5000" MinHeight="80" MaxHeight="200" TextChanged="NoteText_Changed"/>
                                        <Button x:Name="HighlightButton" Click="Highlight_Click"/>
                                        <TextBlock x:Name="AnnotationStatus" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </SplitView>
                <views:WelcomeView x:Name="Welcome" Background="Transparent"/>

                <!-- Find bar floats over the document so opening it never shifts the page being read. -->
                <Border
                    x:Name="SearchPanel"
                    Visibility="Collapsed"
                    MaxWidth="440"
                    Margin="12,12,12,0"
                    Padding="8"
                    VerticalAlignment="Top"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    Translation="0,0,32">
                    <Border.Shadow><ThemeShadow/></Border.Shadow>
                    <Grid ColumnSpacing="4" RowSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="Find in document…" MaxLength="500" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                        <ToggleButton x:Name="MatchCaseBox" Grid.Column="1" Content="Aa" Width="36" Height="32" Padding="0" Checked="MatchCase_Changed" Unchecked="MatchCase_Changed"/>
                        <Button x:Name="FindPreviousButton" Grid.Column="2" Click="FindPrevious_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
                        <Button x:Name="FindNextButton" Grid.Column="3" Click="FindNext_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
                        <Button x:Name="CloseSearchButton" Grid.Column="4" Click="CloseSearch_Click" Style="{StaticResource QuietButton}"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                        <TextBlock x:Name="SearchResultText" Grid.Row="1" Grid.ColumnSpan="5" Margin="4,0,4,2" Text="Search selectable text in this PDF" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Border>

                <Grid x:Name="BusyOverlay" Background="{ThemeResource SmokeFillColorDefaultBrush}" Visibility="Collapsed">
                    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="16" MaxWidth="320">
                            <ProgressRing IsActive="True" Width="32" Height="32" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="BusyText" Text="Opening your document…" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <Button x:Name="CancelBusyButton" Content="Cancel" MinWidth="96" HorizontalAlignment="Center" Click="Cancel_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid
            x:Name="StatusBar"
            Grid.Row="2"
            Height="28"
            Padding="16,0"
            ColumnSpacing="16"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="PrivacyText" Grid.Column="1" Text="On this device" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Grid>
</Window>
