<UserControl x:Class="PdfReader.Views.WelcomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <ScrollViewer x:Name="WelcomeScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" SizeChanged="Scroll_SizeChanged">
  <Grid x:Name="WelcomeContent" MaxWidth="860" Margin="28,44,28,32" HorizontalAlignment="Center">
   <StackPanel Spacing="28">
    <StackPanel Spacing="10">
     <TextBlock Text="YOUR READING SPACE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
     <TextBlock x:Name="WelcomeHeading" Text="Welcome to Folio" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="All your documents. A little more clarity." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="16"/>
    </StackPanel>
    <Border CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24">
     <Grid ColumnSpacing="24" RowSpacing="20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="DocumentArtwork" Width="70" Height="84" CornerRadius="10" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Top">
       <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
      </Border>
      <StackPanel x:Name="OpenCardText" Grid.Column="1" Spacing="7" VerticalAlignment="Center">
       <TextBlock Text="Open a PDF" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="Drop a document into this window, or choose one from your device." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="14"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14">
       <Button Click="Open_Click" Style="{StaticResource AccentButtonStyle}" Padding="20,11" AutomationProperties.Name="Open a PDF from your device">
        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8E5;" FontSize="15"/><TextBlock Text="Choose a document"/></StackPanel>
       </Button>
       <TextBlock x:Name="OpenShortcut" Text="Ctrl + O" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
      </StackPanel>
     </Grid>
    </Border>
    <StackPanel Spacing="14">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
       <TextBlock Text="Recent documents" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="Pick up right where you left off." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
      <Button x:Name="ClearButton" Grid.Column="1" Content="Clear history" VerticalAlignment="Center" Click="Clear_Click" Background="Transparent" BorderThickness="0" FontSize="12"/>
     </Grid>
     <Border x:Name="EmptyRecents" BorderThickness="1" CornerRadius="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="22">
      <StackPanel Spacing="7">
       <TextBlock Text="A fresh page" FontWeight="SemiBold"/>
       <TextBlock Text="Your recently opened PDFs will appear here, with your page and zoom remembered." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
      </StackPanel>
     </Border>
     <ListView x:Name="RecentList" IsItemClickEnabled="True" ItemClick="Recent_Click" SelectionMode="None" MaxHeight="320" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Recently opened PDFs">
      <ListView.ItemTemplate><DataTemplate>
       <Grid Padding="6,12" ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
        <Border Width="36" Height="44" CornerRadius="5" Background="{ThemeResource AccentFillColorTertiaryBrush}"><FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Border>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       </Grid>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock Text="Private by design. Your PDFs stay on this device." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</UserControl>
